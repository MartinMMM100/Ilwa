{
  "expo": {
    "name": "ILWA SafetyMap",
    "slug": "ilwa-safety-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.ilwa.safetymap"
    },
    "android": {
      "package": "za.co.ilwa.safetymap",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ILWA to record a voice note for your community safety report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ILWA to attach a photo to your community safety report.",
          "cameraPermission": "Allow ILWA to take a photo for your community safety report.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
