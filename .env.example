# Server-only MongoDB settings. Never expose these as EXPO_PUBLIC_* values.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ilwa

# Incident extraction runs on the server. Use "mock" for deterministic local fixtures or
# "openai" for real structured extraction. Never expose OPENAI_API_KEY as EXPO_PUBLIC_*.
INCIDENT_EXTRACTOR=mock
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_INCIDENT_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Authentication has not been added to this app yet. This identity is development-only;
# the API refuses to start with it when NODE_ENV=production.
DEV_REPORTER_ID=development-only-resident

PORT=4000
CLIENT_ORIGIN=http://localhost:8081

# Public app setting. Use your computer's LAN IP for a physical Expo device.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional integration-test settings. MONGODB_TEST_DB must differ from MONGODB_DB.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017
MONGODB_TEST_DB=ilwa_test
